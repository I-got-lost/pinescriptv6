// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Universal Learning Pattern Recognition Strategy

//@version=6
strategy("Universal Learning Pattern Recognition", overlay = true, default_qty_type = strategy.percent_of_equity, default_qty_value = 10, initial_capital = 100000, commission_type = strategy.commission.percent, commission_value = 0.04, slippage = 1, pyramiding = 0, calc_on_every_tick = false)

// ──────────────────────────────────────────────────────────────────────────────
// CONSTANTS
// ──────────────────────────────────────────────────────────────────────────────
int   DIVERG_LOOKBACK = 5

// ──────────────────────────────────────────────────────────────────────────────
// INPUTS — Section A: Trend Core
// ──────────────────────────────────────────────────────────────────────────────
string GRP_TREND = "═══ A. Trend Core ═══"
int    i_emaFastLen   = input.int(9,    "Fast EMA Length",          minval = 2, maxval = 200,  group = GRP_TREND)
int    i_emaSlowLen   = input.int(21,   "Slow EMA Length",          minval = 2, maxval = 400,  group = GRP_TREND)
int    i_smaBaseLen   = input.int(50,   "Baseline SMA Length",      minval = 5, maxval = 500,  group = GRP_TREND)
int    i_hmaLen       = input.int(14,   "Hull MA Length",           minval = 2, maxval = 200,  group = GRP_TREND)
bool   i_showMAs      = input.bool(true, "Show Moving Averages",    group = GRP_TREND)

// ──────────────────────────────────────────────────────────────────────────────
// INPUTS — Section B: Momentum Engine
// ──────────────────────────────────────────────────────────────────────────────
string GRP_MOM = "═══ B. Momentum Engine ═══"
int    i_rsiLen       = input.int(14,   "RSI Length",               minval = 2, maxval = 100,  group = GRP_MOM)
int    i_macdFast     = input.int(12,   "MACD Fast Length",         minval = 2, maxval = 100,  group = GRP_MOM)
int    i_macdSlow     = input.int(26,   "MACD Slow Length",         minval = 2, maxval = 200,  group = GRP_MOM)
int    i_macdSig      = input.int(9,    "MACD Signal Length",       minval = 2, maxval = 50,   group = GRP_MOM)
int    i_stochLen     = input.int(14,   "Stochastic Length",        minval = 2, maxval = 100,  group = GRP_MOM)
int    i_momLen       = input.int(10,   "Momentum Length",          minval = 1, maxval = 100,  group = GRP_MOM)
bool   i_useDiverg    = input.bool(true, "Enable Divergence Detection", group = GRP_MOM)

// ──────────────────────────────────────────────────────────────────────────────
// INPUTS — Section C: Volatility Envelope
// ──────────────────────────────────────────────────────────────────────────────
string GRP_VOL = "═══ C. Volatility Envelope ═══"
int    i_atrLen       = input.int(14,   "ATR Length",               minval = 2, maxval = 100,  group = GRP_VOL)
int    i_bbLen        = input.int(20,   "Bollinger Band Length",    minval = 2, maxval = 200,  group = GRP_VOL)
float  i_bbMult       = input.float(2.0, "Bollinger Band Multiplier", minval = 0.5, maxval = 5.0, step = 0.1, group = GRP_VOL)
int    i_kcLen        = input.int(20,   "Keltner Channel Length",   minval = 2, maxval = 200,  group = GRP_VOL)
float  i_kcMult       = input.float(1.5, "Keltner Channel Multiplier", minval = 0.5, maxval = 5.0, step = 0.1, group = GRP_VOL)
bool   i_showBB       = input.bool(true, "Show Bollinger Bands",    group = GRP_VOL)
bool   i_showKC       = input.bool(false, "Show Keltner Channels",  group = GRP_VOL)

// ──────────────────────────────────────────────────────────────────────────────
// INPUTS — Section D: Pattern Recognition
// ──────────────────────────────────────────────────────────────────────────────
string GRP_PAT = "═══ D. Pattern Recognition ═══"
int    i_pivotLeft    = input.int(5,    "Pivot Lookback (Left Bars)",  minval = 1, maxval = 20, group = GRP_PAT)
int    i_pivotRight   = input.int(5,    "Pivot Lookahead (Right Bars)", minval = 1, maxval = 20, group = GRP_PAT)
int    i_risingLen    = input.int(3,    "Rising/Falling Bars",      minval = 2, maxval = 10,  group = GRP_PAT)
int    i_linregLen    = input.int(20,   "Linear Regression Length",  minval = 5, maxval = 100, group = GRP_PAT)
bool   i_showPivots   = input.bool(true, "Show Pivot Points",       group = GRP_PAT)

// ──────────────────────────────────────────────────────────────────────────────
// INPUTS — Section E: Adaptive Weighting & Confluence
// ──────────────────────────────────────────────────────────────────────────────
string GRP_WEIGHT = "═══ E. Adaptive Weighting ═══"
float  i_wTrend       = input.float(0.40, "Weight: Trend",          minval = 0.0, maxval = 1.0, step = 0.05, group = GRP_WEIGHT)
float  i_wMom         = input.float(0.35, "Weight: Momentum",       minval = 0.0, maxval = 1.0, step = 0.05, group = GRP_WEIGHT)
float  i_wVol         = input.float(0.25, "Weight: Volatility",     minval = 0.0, maxval = 1.0, step = 0.05, group = GRP_WEIGHT)
int    i_smoothLen    = input.int(5,    "Score Smoothing Length",    minval = 1, maxval = 50,   group = GRP_WEIGHT)
bool   i_adaptiveSmooth = input.bool(true, "Adaptive Smoothing (Volatility-Based)", group = GRP_WEIGHT)
int    i_confluenceMin = input.int(2,   "Min Confluence Count (1-3)", minval = 1, maxval = 3,   group = GRP_WEIGHT)

// ──────────────────────────────────────────────────────────────────────────────
// INPUTS — Section F: Signal Generation & Risk
// ──────────────────────────────────────────────────────────────────────────────
string GRP_SIG = "═══ F. Signal & Risk Management ═══"
float  i_bullThresh   = input.float(0.25, "Bull Threshold",         minval = 0.01, maxval = 0.99, step = 0.05, group = GRP_SIG)
float  i_bearThresh   = input.float(-0.25, "Bear Threshold",        minval = -0.99, maxval = -0.01, step = 0.05, group = GRP_SIG)
bool   i_confirmClose = input.bool(true, "Require Bar Confirmation (No Repaint)", group = GRP_SIG)
bool   i_useStopLoss  = input.bool(true, "Enable ATR Stop-Loss",    group = GRP_SIG)
float  i_slAtrMult    = input.float(2.0, "Stop-Loss ATR Multiplier", minval = 0.5, maxval = 10.0, step = 0.5, group = GRP_SIG)
bool   i_useTakeProfit = input.bool(true, "Enable ATR Take-Profit", group = GRP_SIG)
float  i_tpAtrMult    = input.float(3.0, "Take-Profit ATR Multiplier", minval = 0.5, maxval = 20.0, step = 0.5, group = GRP_SIG)
bool   i_filterGaps   = input.bool(true, "Filter Session Gaps (Futures)", group = GRP_SIG)
bool   i_useAlerts    = input.bool(true, "Enable Alerts",           group = GRP_SIG)

// ──────────────────────────────────────────────────────────────────────────────
// INPUTS — Section G: Visual Settings
// ──────────────────────────────────────────────────────────────────────────────
string GRP_VIS = "═══ G. Visual Settings ═══"
color  i_bullColor    = input.color(color.new(#26a69a, 0), "Bull Color",  group = GRP_VIS)
color  i_bearColor    = input.color(color.new(#ef5350, 0), "Bear Color",  group = GRP_VIS)
color  i_neutralColor = input.color(color.new(#787b86, 50), "Neutral Color", group = GRP_VIS)
bool   i_showBg       = input.bool(true, "Show Signal Background",  group = GRP_VIS)
bool   i_showLabels   = input.bool(true, "Show Entry/Exit Labels",  group = GRP_VIS)
int    i_bgTransp     = input.int(85,   "Background Transparency",  minval = 50, maxval = 99, group = GRP_VIS)

// ──────────────────────────────────────────────────────────────────────────────
// COMPONENT A — TREND CORE
// ──────────────────────────────────────────────────────────────────────────────
float emaFast   = ta.ema(close, i_emaFastLen)
float emaSlow   = ta.ema(close, i_emaSlowLen)
float smaBase   = ta.sma(close, i_smaBaseLen)
float hmaSmooth = ta.hma(close, i_hmaLen)

// Normalize trend score to [-1, +1] using ATR-based scaling
float atrNorm    = ta.atr(i_atrLen)
float trendRaw   = nz(atrNorm) > 0 ? (emaFast - emaSlow) / atrNorm : 0.0
float sTrend     = math.max(-1.0, math.min(1.0, trendRaw))

// Trend sub-signals (for confluence counting)
bool trendBullish = emaFast > emaSlow and close > smaBase and hmaSmooth > hmaSmooth[1]
bool trendBearish = emaFast < emaSlow and close < smaBase and hmaSmooth < hmaSmooth[1]

// ──────────────────────────────────────────────────────────────────────────────
// COMPONENT B — MOMENTUM ENGINE
// ──────────────────────────────────────────────────────────────────────────────
float rsiVal     = ta.rsi(close, i_rsiLen)
[macdLine, signalLine, histLine] = ta.macd(close, i_macdFast, i_macdSlow, i_macdSig)
float stochVal   = ta.stoch(close, high, low, i_stochLen)
float momVal     = ta.mom(close, i_momLen)

// Normalize each to [-1, +1]
float rsiNorm    = (nz(rsiVal, 50) - 50.0) / 50.0
float macdNorm   = nz(atrNorm) > 0 ? math.max(-1.0, math.min(1.0, nz(histLine) / atrNorm)) : 0.0
float stochNorm  = (nz(stochVal, 50) - 50.0) / 50.0
float momNorm    = nz(atrNorm) > 0 ? math.max(-1.0, math.min(1.0, nz(momVal) / (atrNorm * 2))) : 0.0

float sMomentum  = (rsiNorm + macdNorm + stochNorm + momNorm) / 4.0

// Divergence detection
bool bullDiverg  = false
bool bearDiverg  = false
if i_useDiverg
    float priceChange = ta.change(close, DIVERG_LOOKBACK)
    float rsiChange   = ta.change(rsiVal, DIVERG_LOOKBACK)
    bullDiverg := priceChange < 0 and rsiChange > 0
    bearDiverg := priceChange > 0 and rsiChange < 0

// Momentum sub-signals (for confluence counting)
bool momBullish = sMomentum > 0.1 or bullDiverg
bool momBearish = sMomentum < -0.1 or bearDiverg

// ──────────────────────────────────────────────────────────────────────────────
// COMPONENT C — VOLATILITY ENVELOPE
// ──────────────────────────────────────────────────────────────────────────────
float atrVal     = ta.atr(i_atrLen)
[bbMiddle, bbUpper, bbLower] = ta.bb(close, i_bbLen, i_bbMult)
[kcMiddle, kcUpper, kcLower] = ta.kc(close, i_kcLen, i_kcMult)

// Volatility percentile rank — high rank = elevated volatility
float volPctRank = ta.percentrank(atrVal, 100)
// Normalize to [-1, +1]: positive = above-average volatility, negative = below
float sVolatility = (nz(volPctRank, 50) - 50.0) / 50.0

// Bollinger Band squeeze detection (BB inside KC)
bool isSqueeze   = bbUpper < kcUpper and bbLower > kcLower

// Volatility sub-signals (for confluence counting)
bool volBullish  = close > bbMiddle and not isSqueeze and sVolatility < 0.5
bool volBearish  = close < bbMiddle and not isSqueeze and sVolatility < 0.5

// ──────────────────────────────────────────────────────────────────────────────
// COMPONENT D — PATTERN RECOGNITION MATRIX
// ──────────────────────────────────────────────────────────────────────────────
// EMA crossover events
bool emaCrossUp   = ta.crossover(emaFast, emaSlow)
bool emaCrossDn   = ta.crossunder(emaFast, emaSlow)

// Pivot points
float pivHigh     = ta.pivothigh(high, i_pivotLeft, i_pivotRight)
float pivLow      = ta.pivotlow(low, i_pivotLeft, i_pivotRight)

// Rising/Falling sequences
bool isRising     = ta.rising(close, i_risingLen)
bool isFalling    = ta.falling(close, i_risingLen)

// Linear regression slope
float linreg      = ta.linreg(close, i_linregLen, 0)
float linregPrev  = ta.linreg(close, i_linregLen, 1)
bool  slopeUp     = linreg > linregPrev
bool  slopeDn     = linreg < linregPrev

// ──────────────────────────────────────────────────────────────────────────────
// COMPONENT E — ADAPTIVE WEIGHTING & CONFLUENCE LOGIC
// ──────────────────────────────────────────────────────────────────────────────
// Normalize weights so they sum to 1.0
float wSum        = i_wTrend + i_wMom + i_wVol
float wTrend      = wSum > 0 ? i_wTrend / wSum : 1.0 / 3.0
float wMom        = wSum > 0 ? i_wMom   / wSum : 1.0 / 3.0
float wVol        = wSum > 0 ? i_wVol   / wSum : 1.0 / 3.0

// Raw composite score
float rawScore    = wTrend * sTrend + wMom * sMomentum + wVol * sVolatility

// Adaptive smoothing: dynamic length based on volatility
float volFactor       = nz(volPctRank, 50) / 100.0
int   dynamicLen      = i_adaptiveSmooth ? math.max(2, math.round(i_smoothLen * (1.0 + volFactor))) : i_smoothLen
float adaptiveAlpha   = 2.0 / (dynamicLen + 1.0)

// Smoothed composite score (persistent across bars)
var float compositeScore = 0.0
compositeScore := adaptiveAlpha * rawScore + (1.0 - adaptiveAlpha) * compositeScore

// Confluence counting: how many of the 3 sub-systems agree on direction
int bullConfluence = (trendBullish ? 1 : 0) + (momBullish ? 1 : 0) + (volBullish ? 1 : 0)
int bearConfluence = (trendBearish ? 1 : 0) + (momBearish ? 1 : 0) + (volBearish ? 1 : 0)

// ──────────────────────────────────────────────────────────────────────────────
// COMPONENT F — SIGNAL GENERATION
// ──────────────────────────────────────────────────────────────────────────────
// Session gap filter for futures
bool isGap = false
if i_filterGaps
    int expectedDur = timeframe.in_seconds() * 1000
    isGap := ta.change(time) > expectedDur * 2

// Confirmation gate
bool confirmed = i_confirmClose ? barstate.isconfirmed : true

// Signal logic
bool longCondition  = compositeScore > i_bullThresh and bullConfluence >= i_confluenceMin and confirmed and not isGap
bool shortCondition = compositeScore < i_bearThresh and bearConfluence >= i_confluenceMin and confirmed and not isGap

// Exit logic: reverse signal or stop/take-profit via strategy.exit
bool exitLong  = compositeScore < 0 and confirmed
bool exitShort = compositeScore > 0 and confirmed

// ──────────────────────────────────────────────────────────────────────────────
// STRATEGY EXECUTION
// ──────────────────────────────────────────────────────────────────────────────
float atrForRisk = ta.atr(i_atrLen)

if longCondition and strategy.position_size <= 0
    strategy.entry("Long", strategy.long, alert_message = "ULPR Long Entry | Score: " + str.tostring(compositeScore, "#.##"))
    if i_useStopLoss or i_useTakeProfit
        float slPoints = i_useStopLoss   ? atrForRisk * i_slAtrMult / syminfo.mintick : na
        float tpPoints = i_useTakeProfit  ? atrForRisk * i_tpAtrMult / syminfo.mintick : na
        strategy.exit("Long Exit", "Long", loss = slPoints, profit = tpPoints, alert_message = "ULPR Long Exit")

if shortCondition and strategy.position_size >= 0
    strategy.entry("Short", strategy.short, alert_message = "ULPR Short Entry | Score: " + str.tostring(compositeScore, "#.##"))
    if i_useStopLoss or i_useTakeProfit
        float slPoints = i_useStopLoss   ? atrForRisk * i_slAtrMult / syminfo.mintick : na
        float tpPoints = i_useTakeProfit  ? atrForRisk * i_tpAtrMult / syminfo.mintick : na
        strategy.exit("Short Exit", "Short", loss = slPoints, profit = tpPoints, alert_message = "ULPR Short Exit")

if exitLong and strategy.position_size > 0 and not longCondition
    strategy.close("Long", comment = "Score reversal", alert_message = "ULPR Long Closed | Score: " + str.tostring(compositeScore, "#.##"))

if exitShort and strategy.position_size < 0 and not shortCondition
    strategy.close("Short", comment = "Score reversal", alert_message = "ULPR Short Closed | Score: " + str.tostring(compositeScore, "#.##"))

// ──────────────────────────────────────────────────────────────────────────────
// ALERTS
// ──────────────────────────────────────────────────────────────────────────────
if i_useAlerts
    if longCondition and strategy.position_size <= 0
        alert("ULPR LONG on " + syminfo.ticker + " | Score: " + str.tostring(compositeScore, "#.##"), alert.freq_once_per_bar_close)
    if shortCondition and strategy.position_size >= 0
        alert("ULPR SHORT on " + syminfo.ticker + " | Score: " + str.tostring(compositeScore, "#.##"), alert.freq_once_per_bar_close)

// ──────────────────────────────────────────────────────────────────────────────
// VISUAL OUTPUT — Chart Overlay
// ──────────────────────────────────────────────────────────────────────────────
// Moving averages
plot(i_showMAs ? emaFast   : na, "Fast EMA",     color.new(#2196f3, 20), 1)
plot(i_showMAs ? emaSlow   : na, "Slow EMA",     color.new(#ff9800, 20), 1)
plot(i_showMAs ? smaBase   : na, "Baseline SMA", color.new(#9c27b0, 40), 1, plot.style_line)
plot(i_showMAs ? hmaSmooth : na, "Hull MA",      color.new(#00bcd4, 20), 2)

// Bollinger Bands
plot(i_showBB ? bbUpper : na, "BB Upper", color.new(#787b86, 60), 1)
plot(i_showBB ? bbLower : na, "BB Lower", color.new(#787b86, 60), 1)
bbFill1 = plot(i_showBB ? bbUpper : na, "BB Fill Upper", na, display = display.none)
bbFill2 = plot(i_showBB ? bbLower : na, "BB Fill Lower", na, display = display.none)
fill(bbFill1, bbFill2, color = i_showBB ? color.new(#787b86, 92) : na, title = "BB Fill")

// Keltner Channels
plot(i_showKC ? kcUpper : na, "KC Upper", color.new(#ff5722, 60), 1)
plot(i_showKC ? kcLower : na, "KC Lower", color.new(#ff5722, 60), 1)

// Signal background
color bgCol = na
if i_showBg
    if compositeScore > i_bullThresh and bullConfluence >= i_confluenceMin
        bgCol := color.new(i_bullColor, i_bgTransp)
    else if compositeScore < i_bearThresh and bearConfluence >= i_confluenceMin
        bgCol := color.new(i_bearColor, i_bgTransp)
bgcolor(bgCol, title = "Signal Background")

// Entry signal shapes
plotshape(i_showLabels and longCondition and strategy.position_size <= 0 ? low : na, "Long Entry", shape.triangleup, location.belowbar, i_bullColor, size = size.small)
plotshape(i_showLabels and shortCondition and strategy.position_size >= 0 ? high : na, "Short Entry", shape.triangledown, location.abovebar, i_bearColor, size = size.small)

// Pivot markers
plotshape(i_showPivots and not na(pivHigh) ? pivHigh : na, "Pivot High", shape.diamond, location.abovebar, color.new(#ff5722, 30), offset = -i_pivotRight, size = size.tiny)
plotshape(i_showPivots and not na(pivLow) ? pivLow : na, "Pivot Low", shape.diamond, location.belowbar, color.new(#4caf50, 30), offset = -i_pivotRight, size = size.tiny)

// Squeeze indicator (dot on bar when BB is inside KC)
plotshape(isSqueeze ? close : na, "Squeeze", shape.circle, location.absolute, color.new(#ff9800, 40), size = size.tiny)

// ──────────────────────────────────────────────────────────────────────────────
// INFO TABLE — Composite Score Dashboard
// ──────────────────────────────────────────────────────────────────────────────
var table scoreTable = table.new(position.top_right, 2, 7, color.new(#1e222d, 10), border_color = color.new(#363a45, 0), border_width = 1)
if barstate.islastconfirmedhistory or barstate.isrealtime
    color scoreColor = compositeScore > i_bullThresh ? i_bullColor : compositeScore < i_bearThresh ? i_bearColor : i_neutralColor
    table.cell(scoreTable, 0, 0, "ULPR Dashboard",  text_color = color.white, text_size = size.small, bgcolor = color.new(#363a45, 0))
    table.cell(scoreTable, 1, 0, "",                 bgcolor = color.new(#363a45, 0))
    table.cell(scoreTable, 0, 1, "Composite Score",  text_color = color.gray,  text_size = size.tiny)
    table.cell(scoreTable, 1, 1, str.tostring(compositeScore, "#.###"), text_color = scoreColor, text_size = size.small)
    table.cell(scoreTable, 0, 2, "Trend",            text_color = color.gray,  text_size = size.tiny)
    table.cell(scoreTable, 1, 2, str.tostring(sTrend, "#.##"), text_color = sTrend > 0 ? i_bullColor : i_bearColor, text_size = size.tiny)
    table.cell(scoreTable, 0, 3, "Momentum",         text_color = color.gray,  text_size = size.tiny)
    table.cell(scoreTable, 1, 3, str.tostring(sMomentum, "#.##"), text_color = sMomentum > 0 ? i_bullColor : i_bearColor, text_size = size.tiny)
    table.cell(scoreTable, 0, 4, "Volatility",       text_color = color.gray,  text_size = size.tiny)
    table.cell(scoreTable, 1, 4, str.tostring(sVolatility, "#.##"), text_color = color.white, text_size = size.tiny)
    table.cell(scoreTable, 0, 5, "Confluence",       text_color = color.gray,  text_size = size.tiny)
    string confStr = compositeScore > 0 ? str.tostring(bullConfluence) + "/3 Bull" : str.tostring(bearConfluence) + "/3 Bear"
    table.cell(scoreTable, 1, 5, confStr,            text_color = color.white, text_size = size.tiny)
    table.cell(scoreTable, 0, 6, "Squeeze",          text_color = color.gray,  text_size = size.tiny)
    table.cell(scoreTable, 1, 6, isSqueeze ? "ACTIVE" : "---", text_color = isSqueeze ? color.orange : color.gray, text_size = size.tiny)
